# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO DEL FRONTEND
# Copia este archivo a .env en tu entorno local antes de ejecutar Vite.
# IMPORTANTE: las variables VITE_* quedan visibles en el navegador (se incrustan
# en el bundle). NUNCA pongas aquí credenciales ni claves.
# ==============================================================================

# Base de la API (relativa al proxy: evita CORS por completo)
VITE_API_BASE_URL=/api/v1

# Nombre de la aplicación
VITE_APP_NAME=HARE-S